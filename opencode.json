{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "dotnet *": "allow",
      "dotnet.exe *": "allow",
      "git *": "allow",
      "git -c *": "allow",
      "git -C *": "allow",
      "GIT_SSL_NO_VERIFY=1 git *": "allow",
      "taskkill *": "allow",
      "tasklist *": "allow",
      "powershell *": "allow",
      "powershell.exe *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "py *": "allow",
      "curl *": "allow",
      "gh *": "allow",
      "cmd *": "allow",
      "cmd.exe *": "allow",
      "explorer *": "allow",
      "start *": "allow",
      "where *": "allow",
      "winget *": "allow",
      "choco *": "allow",
      "cmake *": "allow",
      "ilspycmd *": "allow",
      "wmic *": "allow",
      "Remove-Item *": "allow",
      "Stop-Process *": "allow",
      "Get-Process *": "allow",
      "Start-Process *": "allow",
      "Test-Path *": "allow",
      "Get-ChildItem *": "allow"
    }
  }
}
