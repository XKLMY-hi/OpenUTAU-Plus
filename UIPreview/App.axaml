<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="using:SukiUI"
             x:Class="UIPreview.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- 与主程序 App.axaml 相同的资源链（无 Strings/语言注册） -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="/Colors/LightTheme.axaml"/>
        <ResourceInclude x:Key="Dark" Source="/Colors/DarkTheme.axaml"/>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Colors/Brushes.axaml"/>
        <ResourceInclude Source="/Themes/Plus.Resources.axaml"/>
        <ResourceInclude Source="/Assets/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Styles.axaml"/>
    <suki:SukiTheme />
    <StyleInclude Source="/Styles/SukiOverrides.axaml"/>
    <StyleInclude Source="/Styles/SukiCompactMenu.axaml"/>
  </Application.Styles>
</Application>
