<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtau.App.Controls.MixerTrackStrip"
             Width="68" MinHeight="300">
  <UserControl.Styles>
    <Style Selector="Button.mixerBtn">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style Selector="Button.mixerBtn.muteOn">
      <Setter Property="Background" Value="#E53935"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mixerBtn.soloOn">
      <Setter Property="Background" Value="#FBC02D"/>
      <Setter Property="Foreground" Value="#1a1a1a"/>
    </Style>
    <Style Selector="Button.fxEntryBtn">
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,6,4,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.fxEntryBtn.fxActive">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentColor1}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentColor1}"/>
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Margin" Value="0,4,0,1"/>
    </Style>
    <Style Selector="TextBlock.trackNameSmall">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="2,3,2,0"/>
    </Style>
    <Style Selector="TextBox.volEdit">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontFamily" Value="monospace"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="0.5" CornerRadius="8" Margin="2,4"
          Padding="4,4,4,4"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Name="RootGrid">
      <!-- Row 0: Track color bar -->
      <Border Name="ColorBar" Height="3" CornerRadius="2"
              Margin="4,2,4,2" Background="{DynamicResource AccentBrush1}"/>

      <!-- Row 1: Track name + M/S buttons -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,1,0,3">
        <TextBlock Grid.Column="0" Classes="trackNameSmall" Name="TrackNameLabel" Text="--"/>
        <Button Grid.Column="1" Classes="mixerBtn" Content="{DynamicResource mixer.mute}" Name="MuteBtn" Click="OnMuteClick"/>
        <Button Grid.Column="2" Classes="mixerBtn" Content="{DynamicResource mixer.solo}" Name="SoloBtn" Click="OnSoloClick"/>
      </Grid>

      <!-- Row 2: Pan slider -->
      <Slider Grid.Row="2" Name="PanSlider"
              Orientation="Horizontal" Height="14" Margin="4,0,4,2"
              Minimum="-100" Maximum="100" TickFrequency="1"/>

      <!-- Row 3: FADER -->
      <Grid Grid.Row="3" Name="FaderBox"
            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
            Margin="8,2,8,2" MinHeight="100"
            ClipToBounds="True"
            PointerPressed="OnFaderPressed"
            PointerMoved="OnFaderMoved">
        <Border Name="LevelFill" VerticalAlignment="Bottom"
                Background="#3027AE60" Height="30"/>
        <Border Name="ThumbBar" VerticalAlignment="Top" Height="8"
                CornerRadius="3"
                Background="{DynamicResource AccentBrush1}"
                BorderBrush="{DynamicResource AccentBrush1}"
                BorderThickness="1" ZIndex="10"
                IsHitTestVisible="False"/>
      </Grid>

      <!-- Row 4: Volume value -->
      <TextBlock Grid.Row="4" Name="VolValueLabel" Classes="sectionLabel"
                 FontSize="11" Opacity="1.0"
                 Text="-3.0 dB"
                 PointerPressed="OnVolLabelPressed"/>

      <!-- Row 5: FX entry button (opens unified TrackEffectRack) -->
      <Button Grid.Row="5" Name="FxEntryBtn" Classes="fxEntryBtn"
              Content="{DynamicResource mixer.fx}" Click="OnFxEntryClick"/>
    </Grid>
  </Border>
</UserControl>
