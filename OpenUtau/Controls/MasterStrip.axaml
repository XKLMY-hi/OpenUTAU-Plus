<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtau.App.Controls.MasterStrip"
             Width="56">
  <UserControl.Styles>
    <Style Selector="Button.mixerBtn">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style Selector="Button.mixerBtn.muteOn">
      <Setter Property="Background" Value="#E53935"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="TextBlock.masterName">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="2,4,2,0"/>
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Margin" Value="0,4,0,1"/>
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="0" CornerRadius="8" Margin="2,4"
          Padding="4,4,4,4"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Name="RootGrid">
      <!-- Row 0: LED 电平表（主输出） -->
      <StackPanel Grid.Row="0" Name="LevelMeterPanel" Margin="8,4,8,2" Spacing="1"/>

      <!-- Row 1: 名称 -->
      <TextBlock Grid.Row="1" Classes="masterName" Name="MasterNameLabel"
                 Text="{DynamicResource mixer.master}"/>

      <!-- Row 2: Master mute -->
      <Button Grid.Row="2" Classes="mixerBtn" Content="{DynamicResource mixer.mute}" Name="MuteBtn"
              Click="OnMuteClick" HorizontalAlignment="Center" Margin="0,4,0,0"/>

      <!-- Row 3: FADER -->
      <Grid Grid.Row="3" Name="FaderBox"
            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
            Margin="8,2,8,2" MinHeight="100"
            ClipToBounds="True"
            PointerPressed="OnFaderPressed"
            PointerMoved="OnFaderMoved">
        <Border Name="FaderRail" Width="4" HorizontalAlignment="Center"
                CornerRadius="2" Background="#30FFFFFF" IsHitTestVisible="False"/>
        <Border Name="ThumbBar" Width="26" Height="4" CornerRadius="2"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush1}"
                BorderBrush="{DynamicResource AccentBrush1}"
                BorderThickness="1" ZIndex="10"
                IsHitTestVisible="False"/>
      </Grid>

      <!-- Row 4: Volume value -->
      <TextBlock Grid.Row="4" Name="VolValueLabel" Classes="sectionLabel"
                 FontSize="11" Opacity="1.0"
                 Text="0.0 dB"/>
    </Grid>
  </Border>
</UserControl>
