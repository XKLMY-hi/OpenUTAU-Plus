<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtau.App.Controls.PanKnob"
             Width="26" Height="26" ToolTip.Tip="Pan (double-click to reset)">
  <Panel Background="Transparent"
         PointerPressed="OnPointerPressed"
         PointerMoved="OnPointerMoved"
         PointerReleased="OnPointerReleased"
         DoubleTapped="OnDoubleTapped">
    <Ellipse Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}" StrokeThickness="1"
             Fill="{DynamicResource SystemControlBackgroundAltMediumBrush}"/>
    <Line Name="Needle" Stroke="{DynamicResource AccentBrush1}" StrokeThickness="1.5"
          StrokeLineCap="Round"/>
  </Panel>
</UserControl>
