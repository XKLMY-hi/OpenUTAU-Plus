<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtau.App.Controls.WindowTitleBar">

  <!-- Custom window title bar: icon + title + min / max / close -->
  <Grid Height="32"
        Background="Transparent"
        PointerPressed="OnTitleBarPointerPressed"
        DoubleTapped="OnTitleBarDoubleTapped">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Left: window icon + title -->
    <StackPanel Grid.Column="0" Orientation="Horizontal"
                VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
      <Image Source="/Assets/open-utau.ico"
             Width="16" Height="16" Margin="0,0,8,0"/>
      <TextBlock Name="TitleText"
                 FontSize="12"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </StackPanel>

    <!-- Right: window controls -->
    <StackPanel Grid.Column="2" Orientation="Horizontal"
                VerticalAlignment="Stretch">
      <!-- Minimize -->
      <Button Width="46" Height="32"
              Classes="titleBarBtn"
              Click="OnMinimize"
              ToolTip.Tip="{DynamicResource window.minimize}">
        <Border Width="10" Height="2"
                Background="{DynamicResource SystemControlForegroundBaseHighBrush}"
                CornerRadius="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
      </Button>

      <!-- Maximize / Restore -->
      <Button Width="46" Height="32"
              Classes="titleBarBtn"
              Click="OnMaximizeRestore"
              Name="MaxRestoreBtn"
              ToolTip.Tip="{DynamicResource window.maximize}">
        <Path Name="MaxRestoreIcon"
              Width="12" Height="12"
              Stretch="Uniform"
              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
              StrokeThickness="1.5"/>
      </Button>

      <!-- Close -->
      <Button Width="46" Height="32"
              Classes="titleBarBtn closeBtn"
              Click="OnClose"
              ToolTip.Tip="{DynamicResource window.close}">
        <Path Data="{StaticResource icon-x}"
              Width="12" Height="12"
              Stretch="Uniform"
              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
              StrokeThickness="1.5"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
