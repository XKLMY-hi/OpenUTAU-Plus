<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Corner Radius -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- Spacing -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>

    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">15</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeHeading">22</x:Double>

    <!-- Control Heights -->
    <x:Double x:Key="ControlHeightSm">28</x:Double>
    <x:Double x:Key="ControlHeightMd">32</x:Double>
    <x:Double x:Key="ControlHeightLg">40</x:Double>

    <!-- Shadows -->
    <BoxShadows x:Key="ShadowCard">0 1 3 1 #20000000</BoxShadows>
    <BoxShadows x:Key="ShadowFlyout">0 4 8 2 #30000000</BoxShadows>
    <BoxShadows x:Key="ShadowDialog">0 8 16 4 #40000000</BoxShadows>

    <!-- Acrylic colors (dark theme baseline; light theme overrides in LightTheme.axaml) -->
    <SolidColorBrush x:Key="AcrylicBgBrush" Color="#2A2838" Opacity="0.45" />
    <SolidColorBrush x:Key="AcrylicBorderBrush" Color="#C73A3F" Opacity="0.18" />
    <SolidColorBrush x:Key="AcrylicBorderHoverBrush" Color="#C73A3F" Opacity="0.40" />
    <SolidColorBrush x:Key="AcrylicGlowBrush" Color="#C73A3F" Opacity="0.12" />
  </Styles.Resources>
</Styles>
