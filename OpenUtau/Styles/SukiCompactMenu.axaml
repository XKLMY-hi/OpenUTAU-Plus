<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    紧凑菜单接管（探针实证：Suki 菜单条模板高 45 + MenuItem 内容区固定 ~10px，
    24px 顶栏内文字被压到 6px 半切）。菜单视觉由 Plus 紧凑模板提供（行高 ~25px）。
    结构：Menu 模板含向下 Popup（顶栏弹出），MenuItem 模板含向右 Popup（二级弹出），
    两者内容统一用 MenuFlyoutPresenter（背景/圆角/投影在此定义）。
    弹出动画：MenuFlyoutPresenter 附加时 Opacity 渐入（Avalonia 12.1 Transition 重构
    无 From/To，用 Style.Animations + KeyFrame 旧语法；注意 Transitions 对象不能放
    资源字典——加载时实例化会崩 headless，探针实证）。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- 纯 ItemsPresenter（Fluent 同款）：Menu 模板不得含 Popup——Popup 内
           ItemsPresenter 会无条件挂载宿主 Items，与菜单条双重挂载崩溃（启动实证）。
           弹出方向由 MenuItem 控件逻辑动态设置（顶层向下/子级向右） -->
      <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Template">
          <ControlTemplate>
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"/>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
              <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}"
                                Width="16" Height="16" Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGesture}"
                         FontSize="11" Opacity="0.5" Margin="16,0,0,0"
                         VerticalAlignment="Center"/>
              <!-- Placement 不硬编码：由 MenuItem 控件逻辑按层级设置（顶层向下/子级向右，
                   探针实证 Fluent 行为；硬编码会锁死方向） -->
              <Popup IsOpen="{TemplateBinding IsSubMenuOpen}"
                     HorizontalOffset="2">
                <Border Background="{DynamicResource PlusBrushSurfaceOverlay}"
                        BorderBrush="{DynamicResource PlusBrushBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource PlusRadiusLg}"
                        BoxShadow="{DynamicResource PlusElevationPopup}"
                        MinWidth="180" Padding="4">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Grid">
          <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceHover}"/>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter">
          <Setter Property="Opacity" Value="0.4"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_PopupBorder"
                    Background="{DynamicResource PlusBrushSurfaceOverlay}"
                    BorderBrush="{DynamicResource PlusBrushBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PlusRadiusLg}"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="{DynamicResource PlusElevationPopup}"
                    MinWidth="180">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

</Styles>
