<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <!-- Acrylic material background: warm light tint at 80% opacity -->
  <SolidColorBrush x:Key="AcrylicTintBrush" Color="#CCf5f2f0"/>

  <!-- Warm gray light palette -->
  <Color x:Key="BackgroundColor">#f5f2f0</Color>
  <Color x:Key="BackgroundColorPointerOver">#ebe7e3</Color>
  <Color x:Key="BackgroundColorPressed">#ddd9d5</Color>
  <Color x:Key="BackgroundColorDisabled">#f0edea</Color>

  <Color x:Key="ForegroundColor">#1a1a20</Color>
  <Color x:Key="ForegroundColorPointerOver">#000000</Color>
  <Color x:Key="ForegroundColorPressed">#282830</Color>
  <Color x:Key="ForegroundColorDisabled">#909098</Color>

  <Color x:Key="BorderColor">#c8c4c0</Color>
  <Color x:Key="BorderColorPointerOver">#a09890</Color>

  <!-- Accent: warm red #c73a3f -->
  <Color x:Key="SystemAccentColor">#c73a3f</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#d94a50</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#b03237</Color>

  <Color x:Key="NeutralAccentColor">#c8c4c0</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#b0aca8</Color>
  <Color x:Key="AccentColor1">#c73a3f</Color>
  <Color x:Key="AccentColor2">#d94a50</Color>
  <Color x:Key="AccentColor3">#b03237</Color>

  <Color x:Key="TickLineColor">#c8c4c0</Color>
  <Color x:Key="BarNumberColor">#787068</Color>
  <Color x:Key="FinalPitchColor">#909098</Color>
  <Color x:Key="TrackBackgroundAltColor">#f0edea</Color>

  <Color x:Key="WarningColor">#FFF4CE</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">Transparent</Color>
  <Color x:Key="WhiteKeyColorRight">Transparent</Color>
  <Color x:Key="WhiteKeyNameColor">#FF347c</Color>

  <Color x:Key="CenterKeyColorLeft">#FFDDE6</Color>
  <Color x:Key="CenterKeyColorRight">#FFCEDC</Color>
  <Color x:Key="CenterKeyNameColor">#FF347C</Color>

  <Color x:Key="BlackKeyColorLeft">#FF71A3</Color>
  <Color x:Key="BlackKeyColorRight">#FF347C</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
