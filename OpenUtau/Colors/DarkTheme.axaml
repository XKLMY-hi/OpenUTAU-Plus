<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <!-- Acrylic material background: warm dark tint at 80% opacity -->
  <SolidColorBrush x:Key="AcrylicTintBrush" Color="#BB282838"/>

  <!-- Warm gray dark palette — see ui-preview-library Design Tokens -->
  <Color x:Key="BackgroundColor">#1e1e28</Color>
  <Color x:Key="BackgroundColorPointerOver">#282838</Color>
  <Color x:Key="BackgroundColorPressed">#303048</Color>
  <Color x:Key="BackgroundColorDisabled">#222230</Color>

  <Color x:Key="ForegroundColor">#f0f0f0</Color>
  <Color x:Key="ForegroundColorPointerOver">#ffffff</Color>
  <Color x:Key="ForegroundColorPressed">#e8e8f0</Color>
  <Color x:Key="ForegroundColorDisabled">#707080</Color>

  <Color x:Key="BorderColor">#383848</Color>
  <Color x:Key="BorderColorPointerOver">#484858</Color>

  <!-- Accent: warm red #c73a3f -->
  <Color x:Key="SystemAccentColor">#c73a3f</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#d94a50</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#b03237</Color>

  <Color x:Key="NeutralAccentColor">#585868</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#686878</Color>
  <Color x:Key="AccentColor1">#c73a3f</Color>
  <Color x:Key="AccentColor2">#d94a50</Color>
  <Color x:Key="AccentColor3">#b03237</Color>

  <Color x:Key="TickLineColor">#383848</Color>
  <Color x:Key="BarNumberColor">#a0a0b0</Color>
  <Color x:Key="FinalPitchColor">#a0a0b0</Color>
  <Color x:Key="TrackBackgroundAltColor">#222230</Color>

  <Color x:Key="WarningColor">#4a3520</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">#CC2A63</Color>
  <Color x:Key="WhiteKeyColorRight">#FF347C</Color>
  <Color x:Key="WhiteKeyNameColor">#FFFFFF</Color>

  <Color x:Key="CenterKeyColorLeft">#CCA5B0</Color>
  <Color x:Key="CenterKeyColorRight">#FFCEDC</Color>
  <Color x:Key="CenterKeyNameColor">#FF347C</Color>

  <Color x:Key="BlackKeyColorLeft">Transparent</Color>
  <Color x:Key="BlackKeyColorRight">Transparent</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
