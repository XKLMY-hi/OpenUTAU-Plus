<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <!-- Warm gray dark palette — see ui-preview-library Design Tokens -->
  <!-- 窗口渐变背景（跟随主题色：底部微注入 accent #B0C4DE ≈ 6%） -->
  <Color x:Key="PlusSurfaceBgTop">#1e1e28</Color>
  <Color x:Key="PlusSurfaceBgBottom">#282029</Color>
  <Color x:Key="BackgroundColor">#1e1e28</Color>
  <Color x:Key="BackgroundColorPointerOver">#282838</Color>
  <Color x:Key="BackgroundColorPressed">#303048</Color>
  <Color x:Key="BackgroundColorDisabled">#222230</Color>

  <Color x:Key="ForegroundColor">#f0f0f0</Color>
  <Color x:Key="ForegroundColorPointerOver">#ffffff</Color>
  <Color x:Key="ForegroundColorPressed">#e8e8f0</Color>
  <Color x:Key="ForegroundColorDisabled">#707080</Color>

  <Color x:Key="BorderColor">#383848</Color>
  <Color x:Key="BorderColorPointerOver">#484858</Color>

  <!-- Accent: warm red #B0C4DE -->
  <Color x:Key="SystemAccentColor">#B0C4DE</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#BED4EE</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#9BABC1</Color>

  <Color x:Key="NeutralAccentColor">#585868</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#686878</Color>
  <Color x:Key="AccentColor1">#B0C4DE</Color>
  <Color x:Key="AccentColor2">#BED4EE</Color>
  <Color x:Key="AccentColor3">#9BABC1</Color>

  <Color x:Key="TickLineColor">#383848</Color>
  <Color x:Key="BarNumberColor">#a0a0b0</Color>
  <Color x:Key="FinalPitchColor">#a0a0b0</Color>
  <Color x:Key="TrackBackgroundAltColor">#222230</Color>

  <Color x:Key="WarningColor">#4a3520</Color>

  <!-- Keyboard Background — warm gray unified; Right = 80% opacity -->
  <Color x:Key="WhiteKeyColorLeft">#1c1c2a</Color>
  <Color x:Key="WhiteKeyColorRight">#CC1c1c2a</Color>
  <Color x:Key="WhiteKeyNameColor">#c8c8d0</Color>

  <Color x:Key="CenterKeyColorLeft">#B0C4DE</Color>
  <Color x:Key="CenterKeyColorRight">#CCFFFFFF</Color>
  <Color x:Key="CenterKeyNameColor">#f0f0f0</Color>

  <Color x:Key="BlackKeyColorLeft">#181820</Color>
  <Color x:Key="BlackKeyColorRight">#CC181820</Color>
  <Color x:Key="BlackKeyNameColor">#808090</Color>

  <!-- ════════ PlusTheme palette v4.0（覆写 Plus.Resources 默认）════════ -->
  <!-- Surface 实色 8 档 -->
  <Color x:Key="PlusSurfaceDeep">#16161e</Color>
  <Color x:Key="PlusSurfaceBase">#1e1e28</Color>
  <Color x:Key="PlusSurfaceRaised">#22222c</Color>
  <Color x:Key="PlusSurfaceControl">#282838</Color>
  <Color x:Key="PlusSurfaceHover">#4682B4</Color>
  <Color x:Key="PlusSurfacePressed">#4682B4</Color>
  <Color x:Key="PlusSurfaceDisabled">#222230</Color>
  <Color x:Key="PlusSurfaceOverlay">#2e2e3e</Color>
  <!-- 对话框卡片（Suki GlassCard 同款质感：29% 白半透明，配合主内容模糊） -->
  <Color x:Key="PlusDialogCard">#B31E1E28</Color>
  <!-- Border -->
  <Color x:Key="PlusBorderSubtle">#2a2a3a</Color>
  <Color x:Key="PlusBorderDefault">#383848</Color>
  <Color x:Key="PlusBorderHover">#484868</Color>
  <Color x:Key="PlusBorderFocus">#B0C4DE</Color>
  <Color x:Key="PlusBorderGlass">#14FFFFFF</Color>
  <Color x:Key="PlusBorderGlassStrong">#1FB0C4DE</Color>
  <!-- Accent -->
  <Color x:Key="PlusAccent">#B0C4DE</Color>
  <Color x:Key="PlusAccentHover">#BED4EE</Color>
  <Color x:Key="PlusAccentPressed">#9BABC1</Color>
  <Color x:Key="PlusAccentMuted">#1FB0C4DE</Color>
  <Color x:Key="PlusAccentSoft">#33B0C4DE</Color>
  <Color x:Key="PlusAccentGlow">#4DB0C4DE</Color>
  <!-- Text -->
  <Color x:Key="PlusTextPrimary">#f0f0f0</Color>
  <Color x:Key="PlusTextSecondary">#a0a0b0</Color>
  <Color x:Key="PlusTextDisabled">#585868</Color>
  <Color x:Key="PlusTextOnAccent">#ffffff</Color>
  <!-- Semantic -->
  <Color x:Key="PlusSemanticSuccess">#4caf50</Color>
  <Color x:Key="PlusSemanticWarning">#ff9800</Color>
  <Color x:Key="PlusSemanticWarningBg">#4a3520</Color>
  <Color x:Key="PlusSemanticDanger">#e53935</Color>
  <Color x:Key="PlusSemanticInfo">#5b9bd5</Color>
  <!-- Glass（仅浮层） -->
  <Color x:Key="PlusGlassCard">#EB1E2028</Color>
  <Color x:Key="PlusGlassPopover">#F0262632</Color>
  <Color x:Key="PlusGlassBackdrop">#80000000</Color>
  <Color x:Key="PlusGlassHeader">#0DFFFFFF</Color>
  <Color x:Key="PlusGlassInsetBottom">#24000000</Color>
</ResourceDictionary>
