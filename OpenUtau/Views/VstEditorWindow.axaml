<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenUtau.App.Views.VstEditorWindow"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource vsteditor.title}" Width="420" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
  <Border Margin="{Binding $parent.WindowDecorationMargin}">
    <DockPanel Margin="14" LastChildFill="True">
      <!-- Plugin info header -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="4">
        <TextBlock FontWeight="SemiBold" FontSize="15" Name="TitleLabel"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Name="TypeBadge" CornerRadius="3" Padding="5,1">
            <TextBlock Name="TypeLabel" FontSize="10" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Name="VendorLabel" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Metadata -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
        <TextBlock Name="SubsLabel" FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
        <TextBlock Name="PathLabel" FontSize="9" Opacity="0.3" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Parameter list area -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0.5"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              CornerRadius="4" Margin="0,4,0,4">
        <DockPanel Margin="8" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" FontSize="9" Opacity="0.4"
                     Text="{DynamicResource vsteditor.pluginparams}" Margin="0,0,0,4"/>
          <ScrollViewer Height="160" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="NativeStatus" FontSize="10" Opacity="0.6"
                       FontFamily="monospace" Text="{DynamicResource vsteditor.loading}"
                       TextWrapping="NoWrap"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Action buttons -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
        <TextBlock Name="ParamInfo" FontSize="10" Opacity="0.4" TextAlignment="Center"/>
        <Button Name="OpenEditorBtn" Content="{DynamicResource vsteditor.opengui}"
                Height="32" FontSize="12" FontWeight="SemiBold"
                Click="OnOpenEditorClick"
                IsEnabled="False"/>
        <Button Content="{DynamicResource vsteditor.close}" Height="28" FontSize="11"
                Click="OnCloseClick"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
