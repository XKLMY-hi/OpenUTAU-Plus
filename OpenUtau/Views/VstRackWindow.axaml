<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        x:Class="OpenUtau.App.Views.VstRackWindow"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource effects.title}" Width="480" Height="380"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Button.addBtn">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Border.slotRow">
      <Setter Property="Height" Value="32"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
    </Style>
    <Style Selector="Border.slotRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
    </Style>
    <Style Selector="TextBlock.slotNum">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="monospace"/>
    </Style>
    <Style Selector="TextBlock.pluginName">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.emptyName">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.35"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="Button.removeBtn">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.addSlotBtn">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.addSlotBtn:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush1}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
    <controls:WindowTitleBar DockPanel.Dock="Top"/>
    <Border>
    <DockPanel Margin="12" LastChildFill="True">
      <!-- Header -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14"
                   Name="TitleLabel" VerticalAlignment="Center"/>
      </Grid>

      <!-- Slot list -->
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" Name="SlotList"/>
      </ScrollViewer>
    </DockPanel>
  </Border>
  </DockPanel>
</controls:WindowEx>
