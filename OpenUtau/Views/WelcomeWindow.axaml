<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:suki="using:SukiUI.Controls"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
        x:Class="OpenUtau.App.Views.WelcomeWindow"
        Width="860" Height="560" Title="OpenUTAU Plus">
  <Window.Styles>
    <Style Selector="Button,ToggleButton">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <!-- 图标按钮 -->
    <Style Selector="Button.iconBtn">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlusSurfaceHover}"/>
    </Style>
    <!-- 动作行（新建/打开/导入） -->
    <Style Selector="Border.welcomeAction">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.welcomeAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlusSurfaceHover}"/>
    </Style>
    <!-- 分区标题 -->
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <!-- 最近/模板列表项 -->
    <Style Selector="ListBox.recentList">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.recentList ListBoxItem">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="ListBox.recentList ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlusSurfaceHover}"/>
    </Style>
    <!-- 底部链接 -->
    <Style Selector="TextBlock.footerLink">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="TextBlock.footerLink:pointerover">
      <Setter Property="Background" Value="{DynamicResource PlusSurfaceHover}"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="32,24,32,18">
    <!-- ══ 品牌条 ══ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- 官方应用图标（Assets/OpenUtau.png） -->
        <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Center"
                Background="{DynamicResource PlusSurfaceControl}">
          <Image Source="/Assets/OpenUtau.png" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="OpenUTAU Plus" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding AppVersion}" FontSize="10" Opacity="0.45" Margin="0,1,0,0"/>
        </StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Classes="iconBtn" HorizontalAlignment="Right"
              VerticalAlignment="Center" Click="OnPreferences">
        <Path Data="{StaticResource icon-settings}" Width="15" Height="15" Stretch="Uniform"
              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
      </Button>
    </Grid>

    <!-- ══ 恢复条 ══ -->
    <Button Grid.Row="1" VerticalAlignment="Top" Margin="0,14,0,0"
            Content="{Binding RecoveryString}" IsVisible="{Binding HasRecovery}"
            Click="OnRecovery" HorizontalAlignment="Stretch" Height="34"
            Background="{DynamicResource WarningBrush}"
            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
            CornerRadius="8"/>

    <!-- ══ 主区：左动作 · 右最近/模板 ══ -->
    <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.6*" Margin="0,16,0,0">
      <!-- 左：动作 -->
      <StackPanel Grid.Column="0" Margin="0,0,28,0">
        <TextBlock Classes="sectionTitle" Text="{DynamicResource welcome.start}"/>
        <Border Classes="welcomeAction" PointerPressed="OnNewProject">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush1Semi}">
              <Path Data="{StaticResource icon-plus}" Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource AccentBrush1}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource welcome.new}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource welcome.new.description}" FontSize="11" Opacity="0.5"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="welcomeAction" PointerPressed="OnOpenProject">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush1Semi}">
              <Path Data="{StaticResource icon-folder-open}" Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource AccentBrush1}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource welcome.open}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource welcome.open.description}" FontSize="11" Opacity="0.5"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="welcomeAction" PointerPressed="OnImportAudio">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush1Semi}">
              <Path Data="{StaticResource icon-music}" Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource AccentBrush1}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource menu.file.importtracks}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource menu.file.importaudio}" FontSize="11" Opacity="0.5"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Classes="welcomeAction" PointerPressed="OnOpenTemplate">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush1Semi}">
              <Path Data="{StaticResource icon-file-plus}" Width="17" Height="17" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource AccentBrush1}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource welcome.template}" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource menu.file.newfromtemplate}" FontSize="11" Opacity="0.5"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <!-- 右：最近项目 + 模板 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,*">
        <TextBlock Classes="sectionTitle" Grid.Row="0" Text="{DynamicResource welcome.recent}"/>
        <ListBox Grid.Row="1" ItemsSource="{Binding RecentFiles}" Classes="recentList"
                 IsVisible="{Binding RecentFiles.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentFileInfo">
              <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                    PointerPressed="OnOpenRecent">
                <Border Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}">
                  <Path Data="{StaticResource icon-file}" Width="12" Height="12" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}"/>
                  <TextBlock FontSize="10" Opacity="0.4"
                             Text="{Binding Directory}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Border Background="{DynamicResource AccentBrush1Semi}"
                          CornerRadius="4" Padding="5,2" HorizontalAlignment="Right">
                    <TextBlock FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush1}"
                               Text="{Binding Format}" Margin="0"/>
                  </Border>
                  <TextBlock FontSize="9" Opacity="0.35"
                             Text="{Binding LastWriteTimeStr}"
                             HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" FontSize="12" Opacity="0.5" Margin="4,12,0,0"
                   Text="{DynamicResource welcome.open.description}"
                   IsVisible="{Binding !RecentFiles.Count}"/>

        <TextBlock Classes="sectionTitle" Grid.Row="2" Margin="0,18,0,8"
                   Text="{DynamicResource welcome.template}"
                   IsVisible="{Binding TemplateFiles.Count}"/>
        <ListBox Grid.Row="3" ItemsSource="{Binding TemplateFiles}" Classes="recentList"
                 IsVisible="{Binding TemplateFiles.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentFileInfo">
              <Grid ColumnDefinitions="Auto,*" Background="Transparent"
                    PointerPressed="OnOpenTemplate">
                <Border Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}">
                  <Path Data="{StaticResource icon-file-plus}" Width="12" Height="12" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </Border>
                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- ══ 底部链接 ══ -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,14,0,0">
      <TextBlock Classes="footerLink" Text="{DynamicResource menu.help.wiki}" PointerPressed="OnWiki"/>
      <TextBlock Classes="footerLink" Text="{DynamicResource menu.help.checkupdate}" PointerPressed="OnCheckUpdate"/>
      <TextBlock Classes="footerLink" Text="{DynamicResource menu.help.reportissue}" PointerPressed="OnReportIssue"/>
      <TextBlock Classes="footerLink" Text="{DynamicResource menu.tools.packages}" PointerPressed="OnPackages"/>
    </StackPanel>
  </Grid>
</controls:WindowEx>
