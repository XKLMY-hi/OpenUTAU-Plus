<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme 根（阶段 C：PlusTheme 退役收敛中）。
    Suki 后挂已接管：Button/ToggleButton/ComboBox/ComboBoxItem/ToggleSwitch/
    CheckBox/RadioButton/Slider/ProgressBar/ListBoxItem/MenuFlyoutPresenter/ToolTip
    （{x:Type} ControlTheme 按 Styles 顺序后者胜）。
    仅保留 Suki 无模板的 TextBox（Suki 7.x 只有 TextBoxExtensions 附加属性）。
    设计纪律 v4.0：hover=表面提亮 · 选中=accent-muted · 玻璃仅浮层 · 内容面全实色。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Plus.TextBox.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
