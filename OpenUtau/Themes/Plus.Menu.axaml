<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme · 浮层（v4.0 · 全实色）
    用户决策：放弃半透明/玻璃，全部纯色。弹层用 PlusSurfaceOverlay（弹出层不透明底）。
    层次靠 1px 描边 + 弹出投影，不靠透明度。
    PART_PopupBorder 保留（现有 /template/ 覆盖继续生效）。
  -->
  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_PopupBorder"
                Background="{DynamicResource PlusBrushSurfaceOverlay}"
                BorderBrush="{DynamicResource PlusBrushBorderDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PlusRadiusLg}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{DynamicResource PlusElevationPopup}"
                MinWidth="180">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- ToolTip：实色弹出层，圆角 Sm -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceOverlay}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusSm}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeSm}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{DynamicResource PlusElevationPopup}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
