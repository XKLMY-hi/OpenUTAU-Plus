<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme · Button（v4.0）
    hover = 表面提亮一档（不浮起不发光）· pressed 更暗 · focus 外圈 accent 环
    PART_ContentPresenter 保留（现有 Button.primary/outline/danger/clear /template/ 选择器继续生效）
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Height" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusMd}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceControl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          TemplatedControl.IsTemplateFocusTarget="True"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceHover}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfacePressed}"/>
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceDisabled}"/>
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>
  </ControlTheme>

  <!--
    PlusTheme · ToggleButton（v4.0）追加
    PART_ContentPresenter 同 Button；^:checked = accent-muted 底 + accent 字 + accent 边框（PlusBrushBorderFocus）。
    ComboBox#PART_ExpandButton 使用内联模板（LocalValue），不受本主题影响。
  -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Height" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusMd}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceControl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          TemplatedControl.IsTemplateFocusTarget="True"/>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceHover}"/>
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfacePressed}"/>
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentMuted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderFocus}"/>
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentSoft}"/>
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceDisabled}"/>
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
