<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls">

  <!-- ══════════════════════════════════════════════════════════════════
       WindowDrawnDecorations — Avalonia 12 官方自绘装饰规范
       （替代 11 时代手搓 WindowTitleBar：统一边框/标题栏/按钮/拖拽）
       设计路线：纯实色。层次 = 1px 描边 + 阴影（PlusElevationRaised），不靠透明度。
       ══════════════════════════════════════════════════════════════════ -->
  <ControlTheme x:Key="{x:Type chrome:WindowDrawnDecorations}"
                TargetType="chrome:WindowDrawnDecorations">
    <Setter Property="DefaultTitleBarHeight" Value="32"/>
    <Setter Property="DefaultFrameThickness" Value="1"/>
    <Setter Property="DefaultShadowThickness" Value="8"/>
    <Setter Property="Template">
      <WindowDrawnDecorationsTemplate>
        <WindowDrawnDecorationsContent>

          <!-- ── Underlay：边框 + 阴影 + 背景（覆盖阴影区/边框/客户区背后）── -->
          <chrome:WindowDrawnDecorationsContent.Underlay>
            <Border Margin="{TemplateBinding ShadowThickness}"
                    Background="{DynamicResource PlusBrushSurfaceBase}"
                    BorderBrush="{DynamicResource PlusBrushBorderDefault}"
                    BorderThickness="{TemplateBinding FrameThickness}"
                    BoxShadow="{DynamicResource PlusElevationRaised}"/>
          </chrome:WindowDrawnDecorationsContent.Underlay>

          <!-- ── Overlay：标题栏 + 窗口控制按钮 ── -->
          <chrome:WindowDrawnDecorationsContent.Overlay>
            <DockPanel Height="{TemplateBinding TitleBarHeight}"
                       VerticalAlignment="Top"
                       Margin="{TemplateBinding ShadowThickness}">

              <!-- 右侧：窗口控制 -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PART_MinimizeButton" Width="46"
                        Classes="titleBarBtn"
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                        ToolTip.Tip="{DynamicResource window.minimize}">
                  <Path Data="{StaticResource icon-minus}" Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"/>
                </Button>
                <Button x:Name="PART_MaximizeButton" Width="46"
                        Classes="titleBarBtn"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                        ToolTip.Tip="{DynamicResource window.maximize}">
                  <Path x:Name="MaxRestoreIcon" Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"
                        Data="{StaticResource icon-square}"/>
                </Button>
                <Button x:Name="PART_CloseButton" Width="46"
                        Classes="titleBarBtn closeBtn"
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"
                        ToolTip.Tip="{DynamicResource window.close}">
                  <Path Data="{StaticResource icon-x}" Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"/>
                </Button>
              </StackPanel>

              <!-- 左侧：图标 + 标题（拖拽区，ElementRole 需设在可命中叶子元素上） -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <Image Source="/Assets/open-utau.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                <TextBlock Text="{TemplateBinding Title}" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PlusBrushTextPrimary}"/>
              </StackPanel>

              <!-- 中间空白区：拖拽区（Background 透明必须显式设置才能参与命中测试） -->
              <Border Background="Transparent"
                      chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
            </DockPanel>
          </chrome:WindowDrawnDecorationsContent.Overlay>

          <!-- ── FullscreenPopover：全屏悬停标题栏 ── -->
          <chrome:WindowDrawnDecorationsContent.FullscreenPopover>
            <DockPanel Height="{TemplateBinding TitleBarHeight}"
                       Background="{DynamicResource PlusBrushSurfaceBase}">
              <!-- 注意：两个槽位共用同一 NameScope，x:Name 只能出现在 Overlay（PART 由官方查找），
                   FullscreenPopover 只保留 ElementRole 驱动行为 -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="46"
                        Classes="titleBarBtn"
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                  <Path Data="{StaticResource icon-minus}" Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"/>
                </Button>
                <Button Width="46"
                        Classes="titleBarBtn"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                  <Path Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"
                        Data="{StaticResource icon-square}"/>
                </Button>
                <Button Width="46"
                        Classes="titleBarBtn closeBtn"
                        chrome:WindowDecorationProperties.ElementRole="CloseButton">
                  <Path Data="{StaticResource icon-x}" Width="12" Height="12"
                        Stretch="Uniform"
                        Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        StrokeThickness="1.5"/>
                </Button>
              </StackPanel>
              <TextBlock Text="{TemplateBinding Title}" FontSize="12"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" Margin="12,0"
                         chrome:WindowDecorationProperties.ElementRole="TitleBar"
                         Foreground="{DynamicResource PlusBrushTextPrimary}"/>
              <Border Background="Transparent"
                      chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
            </DockPanel>
          </chrome:WindowDrawnDecorationsContent.FullscreenPopover>

        </WindowDrawnDecorationsContent>
      </WindowDrawnDecorationsTemplate>
    </Setter>

    <!-- 最大化/全屏时去边框 -->
    <Style Selector="^:maximized /template/ Border">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="^:maximized /template/ Path#MaxRestoreIcon">
      <Setter Property="Data" Value="M16.5 7.5V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h1.5m6-9h3.75A2.25 2.25 0 0 1 13.5 9.75v3.75H9.75a2.25 2.25 0 0 0-2.25 2.25V18a2.25 2.25 0 0 0 2.25 2.25h6A2.25 2.25 0 0 0 18 18v-6a2.25 2.25 0 0 0-2.25-2.25H16.5V7.5Z"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
