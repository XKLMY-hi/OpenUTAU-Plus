<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme · ComboBox / ComboBoxItem（v4.0）
    ComboBox PART：Border#Background · PART_ContentPresenter · Path#DropDownGlyph ·
                  ToggleButton#PART_ExpandButton（透明覆盖层，IsChecked↔IsDropDownOpen 双向，
                  借 ButtonBase 先置 Handled 避免 ComboBox 双击切换）· Popup#PART_Popup ·
                  Border#PopupBorder · ScrollViewer#PART_ScrollViewer · ItemsPresenter#PART_ItemsPresenter。
    弹层玻璃：PlusBrushGlassPopover + PlusBorderGlass 描边 + PlusElevationPopup 落影 + PlusHighlightTop 顶光。
    主框 v4.0：hover 边框提亮 · focus accent 边框 + PlusFocusRing · disabled 降面降字。
  -->
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceControl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusMd}"/>
    <Setter Property="MinHeight" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="Height" Value="{DynamicResource PlusControlHeight}"/>
    <Setter Property="Padding" Value="10,0,8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource PlusBrushTextSecondary}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Grid ColumnDefinitions="*,Auto">
            <Border x:Name="Background"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{DynamicResource ComboBoxThemeMinWidth}"
                    TemplatedControl.IsTemplateFocusTarget="True"/>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="0"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
            <Path x:Name="DropDownGlyph"
                  Grid.Column="1"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{DynamicResource PlusBrushTextSecondary}"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  Margin="0,0,10,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"/>
            <ToggleButton x:Name="PART_ExpandButton"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Focusable="False"
                          IsTabStop="False"
                          Background="Transparent"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
              <ToggleButton.Template>
                <ControlTemplate>
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   IsLightDismissEnabled="True">
              <Border x:Name="PopupBorder"
                      Background="{DynamicResource PlusBrushGlassPopover}"
                      BorderBrush="{DynamicResource PlusBrushBorderGlass}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource PlusRadiusLg}"
                      Padding="4"
                      BoxShadow="{DynamicResource PlusHighlightTop}, {DynamicResource PlusElevationPopup}">
                <ScrollViewer x:Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- PointerOver：表面提亮 + 边框提亮 -->
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderHover}"/>
    </Style>

    <!-- Pressed：更暗 -->
    <Style Selector="^:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfacePressed}"/>
    </Style>

    <!-- Focus：accent 边框 + 焦点环 -->
    <Style Selector="^:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderFocus}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>

    <!-- Disabled：降面降字降箭头 -->
    <Style Selector="^:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceDisabled}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
    </Style>
    <Style Selector="^:disabled /template/ Path#DropDownGlyph">
      <Setter Property="Fill" Value="{DynamicResource PlusBrushTextDisabled}"/>
    </Style>
  </ControlTheme>

  <!-- ══════════ ComboBoxItem ══════════ -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Padding" Value="6,10"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusSm}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Foreground="{TemplateBinding Foreground}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Padding="{TemplateBinding Padding}"/>
      </ControlTemplate>
    </Setter>

    <!-- Hover：表面提亮 -->
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceHover}"/>
    </Style>

    <!-- Selected：accent-muted 底 + accent 字 -->
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentMuted}"/>
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
    </Style>
    <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentSoft}"/>
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>
