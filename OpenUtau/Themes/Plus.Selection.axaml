<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme · Selection（v4.0）ToggleSwitch / CheckBox / RadioButton
    选中 = accent 实色（轨道/勾选）· hover = 表面提亮或 accent-soft 描边 · disabled 降透明。
    ToggleSwitch 必需 PART_MovingKnobs（Avalonia 代码 IsRequired，缺失会抛异常）——
    ToggleSwitch.cs 用 PART_SwitchKnob.Bounds.Width 驱动 Canvas.Left，故画布宽度即滑块行程。
  -->

  <!-- ══════════ ToggleSwitch ══════════ -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="OuterBorder"
              RowDefinitions="Auto,*"
              MinHeight="32">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Row="0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="0,0,0,4"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextBlock.Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"/>
          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,12,Auto"
                VerticalAlignment="Center">
            <Border x:Name="SwitchKnobBounds"
                    Grid.Column="0"
                    Width="46"
                    Height="26"
                    VerticalAlignment="Center"
                    CornerRadius="{DynamicResource PlusRadiusPill}"
                    Background="{DynamicResource PlusBrushSurfacePressed}"
                    BorderBrush="{DynamicResource PlusBrushBorderDefault}"
                    BorderThickness="1"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <!-- HorizontalAlignment=Left 关键：防止 Canvas Stretch 拉伸导致 Bounds.Width 变大，
                   ToggleSwitch.cs 用 Bounds.Width 作 knob 行程 → 不设会飞向右偏 -->
              <Canvas x:Name="PART_SwitchKnob"
                      Width="20"
                      Height="26"
                      HorizontalAlignment="Left"
                      Margin="2,0,0,0">
                <Grid x:Name="PART_MovingKnobs"
                      Canvas.Top="3"
                      Width="20"
                      Height="20">
                  <Border x:Name="SwitchKnobOnBorder"
                          Width="20"
                          Height="20"
                          CornerRadius="{DynamicResource PlusRadiusPill}"
                          BoxShadow="{DynamicResource PlusElevationContact}"
                          Opacity="0">
                    <Ellipse x:Name="SwitchKnobOn" Fill="{DynamicResource PlusBrushTextOnAccent}"/>
                  </Border>
                  <Border x:Name="SwitchKnobOffBorder"
                          Width="20"
                          Height="20"
                          CornerRadius="{DynamicResource PlusRadiusPill}"
                          BoxShadow="{DynamicResource PlusElevationContact}">
                    <Ellipse x:Name="SwitchKnobOff" Fill="{DynamicResource PlusBrushTextOnAccent}"/>
                  </Border>
                </Grid>
              </Canvas>
            </Border>
            <ContentPresenter x:Name="PART_OffContentPresenter"
                              Grid.Column="2"
                              Content="{TemplateBinding OffContent}"
                              ContentTemplate="{TemplateBinding OffContentTemplate}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{DynamicResource PlusBrushTextSecondary}"/>
            <ContentPresenter x:Name="PART_OnContentPresenter"
                              Grid.Column="2"
                              Content="{TemplateBinding OnContent}"
                              ContentTemplate="{TemplateBinding OnContentTemplate}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              TextBlock.Foreground="{DynamicResource PlusBrushTextSecondary}"
                              Opacity="0"/>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- 轨道：checked = accent 实心；unchecked = pressed 面（模板默认） -->
    <Style Selector="^:pointerover /template/ Border#SwitchKnobBounds">
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderHover}"/>
    </Style>
    <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushAccent}"/>
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushAccentHover}"/>
    </Style>
    <Style Selector="^:checked:pressed /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentPressed}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushAccentPressed}"/>
    </Style>

    <!-- 滑块位移由 ToggleSwitch.cs 代码驱动（Canvas.Left = PART_SwitchKnob.Bounds.Width），无需样式设置 -->


    <!-- 滑块 On/Off 可见性 -->
    <Style Selector="^:checked /template/ Border#SwitchKnobOnBorder">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:checked /template/ Border#SwitchKnobOffBorder">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:unchecked /template/ Border#SwitchKnobOnBorder">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:unchecked /template/ Border#SwitchKnobOffBorder">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- On/Off 内容 -->
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Focus / Disabled -->
    <Style Selector="^:focus-visible /template/ Border#SwitchKnobBounds">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
      <Style Selector="^ /template/ Border#SwitchKnobBounds">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </Style>
  </ControlTheme>

  <!-- ══════════ CheckBox ══════════ -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="20,*">
          <Grid Grid.Column="0"
                Width="20"
                Height="20"
                VerticalAlignment="Top"
                HorizontalAlignment="Left">
            <Border x:Name="NormalRectangle"
                    Width="20"
                    Height="20"
                    Background="{DynamicResource PlusBrushSurfaceControl}"
                    BorderBrush="{DynamicResource PlusBrushBorderHover}"
                    BorderThickness="1.5"
                    CornerRadius="{DynamicResource PlusRadiusXs}"
                    TemplatedControl.IsTemplateFocusTarget="True"/>
            <Viewbox Stretch="Uniform"
                     Margin="3">
              <Path x:Name="CheckGlyph"
                    Data="M 0 0 L 1 1 M 1 1 L 2 0"
                    Stroke="{DynamicResource PlusBrushTextOnAccent}"
                    StrokeThickness="0.4"
                    Opacity="0"/>
            </Viewbox>
          </Grid>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextBlock.Foreground="{TemplateBinding Foreground}"
                            TextWrapping="Wrap"
                            RecognizesAccessKey="True"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Hover：accent-soft 描边 -->
    <Style Selector="^:pointerover /template/ Border#NormalRectangle">
      <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushAccentSoft}"/>
    </Style>

    <!-- Checked：accent 实底 + 对勾可见 -->
    <Style Selector="^:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccent}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Focus / Disabled -->
    <Style Selector="^:focus-visible /template/ Border#NormalRectangle">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
      <Style Selector="^ /template/ Border#NormalRectangle">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </Style>
  </ControlTheme>

  <!-- ══════════ RadioButton ══════════ -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="RootBorder" ColumnDefinitions="20,*">
          <Border x:Name="RadioFocusTarget"
                  Grid.Column="0"
                  Width="20"
                  Height="20"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left"
                  CornerRadius="{DynamicResource PlusRadiusPill}"
                  TemplatedControl.IsTemplateFocusTarget="True">
            <Grid Width="20" Height="20">
              <Ellipse x:Name="OuterEllipse"
                       Width="18"
                       Height="18"
                       Fill="Transparent"
                       Stroke="{DynamicResource PlusBrushBorderHover}"
                       StrokeThickness="1.5"/>
              <Ellipse x:Name="CheckOuterEllipse"
                       Width="8"
                       Height="8"
                       Fill="{DynamicResource PlusBrushAccent}"
                       Opacity="0"/>
              <Ellipse x:Name="CheckGlyph"
                       Width="4"
                       Height="4"
                       Fill="{DynamicResource PlusBrushTextOnAccent}"
                       Opacity="0"/>
            </Grid>
          </Border>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextBlock.Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True"/>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Hover：外圈 accent-soft -->
    <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{DynamicResource PlusBrushAccentSoft}"/>
    </Style>

    <!-- Checked：外圈 accent 描边 + 内圆 accent 填充 + 白芯 -->
    <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{DynamicResource PlusBrushAccent}"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Focus / Disabled -->
    <Style Selector="^:focus-visible /template/ Border#RadioFocusTarget">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
      <Style Selector="^ /template/ Ellipse#OuterEllipse">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
