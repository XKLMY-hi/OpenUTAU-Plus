<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PlusTheme · Slider / ProgressBar（v4.0）
    Slider PART：PART_Track · PART_DecreaseButton · PART_IncreaseButton · Thumb#thumb。
    轨道 4px 圆角（PlusBrushSurfacePressed）· 已填段 accent（Foreground）· 拇指 16×16 accent 圆 + 接触阴影。
    暂只提供横向默认模板（.fader 变体在 Styles.axaml 用旧模板，未动；^:vertical 后续再补）。
    ProgressBar PART：PART_Indicator（Border，Avalonia 代码 IsRequired，宽度由代码按 Value/Maximum 计算）；
    不定态走 Fluent 的 ContainerWidth/ContainerAnimation*Position 绑定 + TranslateTransform.X 位移动画。
  -->

  <!-- ══════════ Slider ══════════ -->
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfacePressed}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border x:Name="SliderRoot"
                  MinHeight="32"
                  TemplatedControl.IsTemplateFocusTarget="True">
            <Grid VerticalAlignment="Center">
              <!-- 轨道底 -->
              <Border Height="4"
                      CornerRadius="{DynamicResource PlusRadiusXs}"
                      Background="{TemplateBinding Background}"
                      VerticalAlignment="Center"/>
              <!-- 已填段(Decrease=Foreground)/未填段(Increase=Background) + 拇指 -->
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Orientation="Horizontal">
                <Track.DecreaseButton>
                  <RepeatButton x:Name="PART_DecreaseButton"
                                IsTabStop="False"
                                Focusable="False"
                                Background="{TemplateBinding Foreground}">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="4" CornerRadius="{DynamicResource PlusRadiusXs}" Background="{TemplateBinding Background}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton x:Name="PART_IncreaseButton"
                                IsTabStop="False"
                                Focusable="False"
                                Background="{TemplateBinding Background}">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="4" CornerRadius="{DynamicResource PlusRadiusXs}" Background="{TemplateBinding Background}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb x:Name="thumb"
                       Width="16"
                       Height="16"
                       Margin="0"
                       Padding="0"
                       Background="{TemplateBinding Foreground}"
                       BorderThickness="0"
                       RenderTransformOrigin="0.5,0.5">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Border Width="16"
                              Height="16"
                              CornerRadius="{DynamicResource PlusRadiusPill}"
                              Background="{TemplateBinding Background}"
                              BoxShadow="{DynamicResource PlusElevationContact}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>

    <!-- 拇指 hover：1.15 缩放（RenderTransform 设在 Thumb 上，缩放整个拇指，不浮起不发光） -->
    <Style Selector="^ /template/ Thumb#thumb:pointerover">
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 拖动/按下：accent 更实（Thumb 仅 :pressed 伪类） -->
    <Style Selector="^ /template/ Thumb#thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource PlusBrushAccentPressed}"/>
    </Style>

    <!-- Focus 环 -->
    <Style Selector="^:focus-visible /template/ Border#SliderRoot">
      <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
    </Style>

    <!-- Disabled：降透明 -->
    <Style Selector="^:disabled /template/ Border#SliderRoot">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
  </ControlTheme>

  <!-- ══════════ ProgressBar ══════════ -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfacePressed}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusXs}"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="ProgressBarRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Panel>
            <Panel x:Name="DeterminateRoot" Opacity="1">
              <Border x:Name="PART_Indicator"
                      Margin="{TemplateBinding Padding}"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"/>
            </Panel>
            <Panel x:Name="IndeterminateRoot" Opacity="0" IsVisible="False">
              <Border x:Name="IndeterminateProgressBarIndicator"
                      Margin="{TemplateBinding Padding}"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Width="{Binding $parent[ProgressBar].TemplateSettings.ContainerWidth}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"/>
            </Panel>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Indeterminate：隐藏 determinate、显示 40% 走位条 -->
    <Style Selector="^:indeterminate /template/ Panel#DeterminateRoot">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="^:indeterminate /template/ Panel#IndeterminateRoot">
      <Setter Property="IsVisible" Value="True"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="^:horizontal:indeterminate /template/ Border#IndeterminateProgressBarIndicator">
      <Style.Animations>
        <Animation IterationCount="Infinite" Duration="0:0:2">
          <KeyFrame KeyTime="0:0:0">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationStartPosition}"/>
          </KeyFrame>
          <KeyFrame KeyTime="0:0:2">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.ContainerAnimationEndPosition}"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
